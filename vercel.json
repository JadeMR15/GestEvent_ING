{
  "buildCommand": "vite build --config vite.csr.config.ts",
  "outputDirectory": "dist/csr",
  "functions": {
    "api/verify-student.ts": {
      "maxDuration": 60,
      "includeFiles": "node_modules/{tesseract.js,tesseract.js-core}/**"
    }
  },
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
